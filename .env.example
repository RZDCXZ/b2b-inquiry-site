# REQUIRED LOCAL DEMO SETTINGS
# Copied to .env by `pnpm setup`. The database password is intentionally scoped
# to the loopback-only Docker demo database. Setup replaces the auth placeholder
# with a random secret and does not overwrite an existing .env file.
DATABASE_URL="postgresql://torquelis:torquelis_local_only@127.0.0.1:55432/torquelis_demo?schema=public"
DEMO_ENVIRONMENT_ID="torquelis-local-demo"
BETTER_AUTH_SECRET="generated-by-pnpm-setup"
BETTER_AUTH_URL="http://127.0.0.1:3000"

# OPTIONAL INTEGRATIONS
# None. This local demonstration does not use real email, storage, analytics,
# CRM, or marketing credentials.

# EXPLICIT SEO-ONLY SETTING
# Indexing stays disabled unless this exact value is changed to "public". This
# setting is not required for normal local use or any automated test.
TORQUELIS_SEO_MODE="private"
