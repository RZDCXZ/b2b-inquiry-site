generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  administrator
  content_editor
  sales
}

enum SpecificationDataType {
  boolean
  decimal
  enumeration
  text
}

enum SpecificationUnit {
  cubic_metre_per_minute
  kilopascal
  litre_per_minute
  micrometre
  millimetre
}

enum ProductStatus {
  draft
  published
  discontinued
}

enum InquiryDisposition {
  accepted
  quarantined
}

enum InquiryInterfaceLanguage {
  en
  zh_cn
}

enum InquiryStatus {
  pending_assignment
  assigned
  in_progress
  quoted
  closed
}

enum InquiryFollowUpType {
  contact
  quote
  internal_note
  correction
}

enum InquiryQuoteCurrency {
  USD
  EUR
  CNY
}

enum InquiryCloseResult {
  won
  lost
  invalid
}

model User {
  id                        String                     @id
  name                      String
  email                     String                     @unique
  emailVerified             Boolean                    @default(true) @map("email_verified")
  image                     String?
  role                      AppRole
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  sessions                  Session[]
  accounts                  Account[]
  auditLogs                 AuditLog[]
  currentOwnedInquiries     Inquiry[]                  @relation("InquiryCurrentOwner")
  lastModifiedInquiries     Inquiry[]                  @relation("InquiryLastModifier")
  inquiryAssignmentsMade    InquiryAssignment[]        @relation("InquiryAssignmentActor")
  inquiryAssignmentsFrom    InquiryAssignment[]        @relation("InquiryAssignmentPreviousOwner")
  inquiryAssignmentsTo      InquiryAssignment[]        @relation("InquiryAssignmentNewOwner")
  inquiryFollowUps          InquiryFollowUp[]
  inquiryStatusChanges      InquiryStatusChange[]
  notificationOutboxRecords NotificationOutboxRecord[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model AuditLog {
  id          String   @id @default(uuid())
  event       String
  outcome     String
  actorUserId String?  @map("actor_user_id")
  actorRole   AppRole? @map("actor_role")
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  summary     String?
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_log")
}

model EnvironmentIdentity {
  key               String   @id @default("primary")
  databaseId        String   @unique @map("database_id")
  environmentMarker String   @map("environment_marker")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("environment_identity")
}

model SiteConfiguration {
  key             String   @id @default("primary")
  companyNameEn   String   @map("company_name_en")
  companyNameZhCn String   @map("company_name_zh_cn")
  contactEmail    String   @map("contact_email")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_configuration")
}

model ProductCategory {
  id                      String                             @id
  code                    String                             @unique
  position                Int                                @unique
  nameEn                  String                             @map("name_en")
  nameZhCn                String                             @map("name_zh_cn")
  products                Product[]
  specificationAttributes SpecificationAttributeDefinition[]

  @@map("product_category")
}

model VehicleMake {
  id     String         @id
  name   String         @unique
  models VehicleModel[]

  @@map("vehicle_make")
}

model VehicleModel {
  id      String      @id
  makeId  String      @map("make_id")
  name    String
  make    VehicleMake @relation(fields: [makeId], references: [id], onDelete: Cascade)
  engines Engine[]

  @@unique([makeId, name])
  @@index([makeId])
  @@map("vehicle_model")
}

model Engine {
  id             String           @id
  vehicleModelId String           @map("vehicle_model_id")
  code           String
  vehicleModel   VehicleModel     @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  fitments       ProductFitment[]

  @@unique([vehicleModelId, code])
  @@unique([id, vehicleModelId])
  @@index([vehicleModelId])
  @@map("engine")
}

model Product {
  id                   String               @id
  partNumber           String               @map("part_number")
  normalizedPartNumber String               @unique @default(dbgenerated()) @map("normalized_part_number")
  categoryId           String               @map("category_id")
  imagePath            String               @map("image_path")
  status               ProductStatus        @default(draft)
  currentPublicationId String?              @unique @map("current_publication_id")
  replacementProductId String?              @map("replacement_product_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  category             ProductCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentPublication   ProductPublication?  @relation("CurrentProductPublication", fields: [id, currentPublicationId], references: [productId, id], onDelete: NoAction)
  replacementProduct   Product?             @relation("ProductReplacement", fields: [replacementProductId], references: [id], onDelete: Restrict)
  replacedProducts     Product[]            @relation("ProductReplacement")
  publications         ProductPublication[] @relation("ProductPublicationVersions")
  inquirySubmissions   InquirySubmission[]
  inquiries            Inquiry[]
  quarantinedInquiries QuarantinedInquiry[]

  @@unique([id, currentPublicationId])
  @@index([categoryId])
  @@index([replacementProductId])
  @@index([status, categoryId])
  @@map("product")
}

model ProductReference {
  id                        String             @id
  publicationId             String             @map("publication_id")
  brand                     String
  referenceNumber           String             @map("reference_number")
  normalizedReferenceNumber String             @default(dbgenerated()) @map("normalized_reference_number")
  publication               ProductPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, brand, normalizedReferenceNumber])
  @@index([normalizedReferenceNumber])
  @@map("product_reference")
}

model SpecificationAttributeDefinition {
  id                  String                         @id
  categoryId          String                         @map("category_id")
  code                String
  position            Int
  nameEn              String                         @map("name_en")
  nameZhCn            String                         @map("name_zh_cn")
  dataType            SpecificationDataType          @map("data_type")
  baseUnit            SpecificationUnit?             @map("base_unit")
  minimumDecimalValue Decimal?                       @map("minimum_decimal_value") @db.Decimal(18, 6)
  maximumDecimalValue Decimal?                       @map("maximum_decimal_value") @db.Decimal(18, 6)
  required            Boolean
  filterable          Boolean
  category            ProductCategory                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options             SpecificationAttributeOption[]
  values              ProductSpecificationValue[]

  @@unique([categoryId, code])
  @@unique([id, dataType])
  @@unique([id, baseUnit])
  @@unique([categoryId, position])
  @@map("specification_attribute_definition")
}

model SpecificationAttributeOption {
  attributeId String                           @map("attribute_id")
  code        String
  position    Int
  labelEn     String                           @map("label_en")
  labelZhCn   String                           @map("label_zh_cn")
  attribute   SpecificationAttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([attributeId, code])
  @@unique([attributeId, position])
  @@map("specification_attribute_option")
}

model ProductSpecificationValue {
  publicationId        String                           @map("publication_id")
  attributeId          String                           @map("attribute_id")
  attributeCode        String                           @map("attribute_code")
  position             Int
  nameEn               String                           @map("name_en")
  nameZhCn             String                           @map("name_zh_cn")
  dataType             SpecificationDataType            @map("data_type")
  baseUnit             SpecificationUnit?               @map("base_unit")
  decimalValue         Decimal?                         @map("decimal_value") @db.Decimal(18, 6)
  booleanValue         Boolean?                         @map("boolean_value")
  enumerationValue     String?                          @map("enumeration_value")
  enumerationLabelEn   String?                          @map("enumeration_label_en")
  enumerationLabelZhCn String?                          @map("enumeration_label_zh_cn")
  textValue            String?                          @map("text_value")
  publication          ProductPublication               @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  attribute            SpecificationAttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([publicationId, attributeId])
  @@unique([publicationId, position])
  @@index([attributeId])
  @@map("product_specification_value")
}

model ProductPublication {
  id                  String                      @id
  productId           String                      @map("product_id")
  version             Int
  nameEn              String                      @map("name_en")
  slugEn              String                      @map("slug_en")
  summaryEn           String                      @map("summary_en")
  nameZhCn            String                      @map("name_zh_cn")
  slugZhCn            String                      @map("slug_zh_cn")
  summaryZhCn         String                      @map("summary_zh_cn")
  publishedAt         DateTime                    @default(now()) @map("published_at")
  product             Product                     @relation("ProductPublicationVersions", fields: [productId], references: [id], onDelete: Cascade)
  currentFor          Product?                    @relation("CurrentProductPublication")
  specificationValues ProductSpecificationValue[]
  references          ProductReference[]
  fitments            ProductFitment[]

  @@unique([productId, version])
  @@unique([productId, id])
  @@map("product_publication")
}

model ProductFitment {
  id             String             @id
  publicationId  String             @map("publication_id")
  vehicleModelId String             @map("vehicle_model_id")
  engineId       String             @map("engine_id")
  yearFrom       Int                @map("year_from")
  yearTo         Int                @map("year_to")
  publication    ProductPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  engine         Engine             @relation(fields: [engineId, vehicleModelId], references: [id, vehicleModelId], onDelete: Restrict)

  @@unique([publicationId, vehicleModelId, engineId, yearFrom, yearTo])
  @@index([vehicleModelId, engineId, yearFrom, yearTo])
  @@map("product_fitment")
}

model InquirySubmission {
  id                    String                   @id @default(uuid())
  tokenHash             String                   @unique @map("token_hash")
  interfaceLanguage     InquiryInterfaceLanguage @map("interface_language")
  sourcePage            String                   @map("source_page")
  productId             String?                  @map("product_id")
  issuedAt              DateTime                 @map("issued_at")
  expiresAt             DateTime                 @map("expires_at")
  completedAt           DateTime?                @map("completed_at")
  referenceNumber       String?                  @unique @map("reference_number")
  disposition           InquiryDisposition?
  clientFingerprintHash String?                  @map("client_fingerprint_hash")
  product               Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  inquiry               Inquiry?
  quarantinedInquiry    QuarantinedInquiry?

  @@index([clientFingerprintHash, completedAt])
  @@index([expiresAt])
  @@map("inquiry_submission")
}

model Inquiry {
  id                    String                     @id @default(uuid())
  referenceNumber       String                     @unique @map("reference_number")
  submissionId          String                     @unique @map("submission_id")
  productId             String?                    @map("product_id")
  status                InquiryStatus              @default(pending_assignment)
  currentOwnerId        String?                    @map("current_owner_id")
  lastModifiedByUserId  String?                    @map("last_modified_by_user_id")
  contactName           String                     @map("contact_name")
  workEmail             String                     @map("work_email")
  company               String
  countryRegion         String                     @map("country_region")
  expectedQuantity      String                     @map("expected_quantity")
  message               String
  phoneOrWhatsapp       String?                    @map("phone_or_whatsapp")
  targetMarket          String?                    @map("target_market")
  privateLabelNeeded    Boolean                    @map("private_label_needed")
  customPackagingNeeded Boolean                    @map("custom_packaging_needed")
  privacyConsentAt      DateTime                   @map("privacy_consent_at")
  sourcePage            String                     @map("source_page")
  interfaceLanguage     InquiryInterfaceLanguage   @map("interface_language")
  submittedAt           DateTime                   @map("submitted_at")
  nextStepDate          DateTime?                  @map("next_step_date") @db.Date
  closeResult           InquiryCloseResult?        @map("close_result")
  closedAt              DateTime?                  @map("closed_at")
  version               Int                        @default(1)
  updatedAt             DateTime                   @default(now()) @updatedAt @map("updated_at")
  submission            InquirySubmission          @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  product               Product?                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  currentOwner          User?                      @relation("InquiryCurrentOwner", fields: [currentOwnerId], references: [id], onDelete: Restrict)
  lastModifiedBy        User?                      @relation("InquiryLastModifier", fields: [lastModifiedByUserId], references: [id], onDelete: Restrict)
  assignmentHistory     InquiryAssignment[]
  followUps             InquiryFollowUp[]
  statusChanges         InquiryStatusChange[]
  notifications         NotificationOutboxRecord[]

  @@index([status, submittedAt])
  @@index([productId])
  @@index([currentOwnerId, status, submittedAt])
  @@map("inquiry")
}

model InquiryFollowUp {
  id              String                @id @default(uuid())
  inquiryId       String                @map("inquiry_id")
  actorUserId     String                @map("actor_user_id")
  type            InquiryFollowUpType
  summary         String
  occurredAt      DateTime              @map("occurred_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  nextStepDate    DateTime?             @map("next_step_date") @db.Date
  quoteAmount     Decimal?              @map("quote_amount") @db.Decimal(18, 2)
  quoteCurrency   InquiryQuoteCurrency? @map("quote_currency")
  quoteValidUntil DateTime?             @map("quote_valid_until") @db.Date
  correctionOfId  String?               @map("correction_of_id")
  statusBefore    InquiryStatus         @map("status_before")
  statusAfter     InquiryStatus         @map("status_after")
  fromVersion     Int                   @map("from_version")
  toVersion       Int                   @map("to_version")
  inquiry         Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  actor           User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  correctionOf    InquiryFollowUp?      @relation("InquiryFollowUpCorrections", fields: [correctionOfId, inquiryId], references: [id, inquiryId], onDelete: Restrict)
  corrections     InquiryFollowUp[]     @relation("InquiryFollowUpCorrections")

  @@unique([id, inquiryId])
  @@unique([inquiryId, toVersion])
  @@index([inquiryId, occurredAt])
  @@index([actorUserId])
  @@map("inquiry_follow_up")
}

model InquiryStatusChange {
  id          String              @id @default(uuid())
  inquiryId   String              @map("inquiry_id")
  actorUserId String              @map("actor_user_id")
  fromStatus  InquiryStatus       @map("from_status")
  toStatus    InquiryStatus       @map("to_status")
  closeResult InquiryCloseResult? @map("close_result")
  reason      String?
  occurredAt  DateTime            @map("occurred_at")
  fromVersion Int                 @map("from_version")
  toVersion   Int                 @map("to_version")
  inquiry     Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  actor       User                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([inquiryId, toVersion])
  @@index([inquiryId, occurredAt])
  @@index([actorUserId])
  @@map("inquiry_status_change")
}

model InquiryAssignment {
  id               String   @id @default(uuid())
  inquiryId        String   @map("inquiry_id")
  previousOwnerId  String?  @map("previous_owner_id")
  newOwnerId       String   @map("new_owner_id")
  assignedByUserId String   @map("assigned_by_user_id")
  reason           String
  assignedAt       DateTime @map("assigned_at")
  fromVersion      Int      @map("from_version")
  toVersion        Int      @map("to_version")
  inquiry          Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  previousOwner    User?    @relation("InquiryAssignmentPreviousOwner", fields: [previousOwnerId], references: [id], onDelete: Restrict)
  newOwner         User     @relation("InquiryAssignmentNewOwner", fields: [newOwnerId], references: [id], onDelete: Restrict)
  assignedBy       User     @relation("InquiryAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@unique([inquiryId, toVersion])
  @@index([inquiryId, assignedAt])
  @@index([previousOwnerId])
  @@index([newOwnerId])
  @@index([assignedByUserId])
  @@map("inquiry_assignment")
}

model QuarantinedInquiry {
  id                    String                   @id @default(uuid())
  referenceNumber       String                   @unique @map("reference_number")
  submissionId          String                   @unique @map("submission_id")
  productId             String?                  @map("product_id")
  contactName           String                   @map("contact_name")
  workEmail             String                   @map("work_email")
  company               String
  countryRegion         String                   @map("country_region")
  expectedQuantity      String                   @map("expected_quantity")
  message               String
  phoneOrWhatsapp       String?                  @map("phone_or_whatsapp")
  targetMarket          String?                  @map("target_market")
  privateLabelNeeded    Boolean                  @map("private_label_needed")
  customPackagingNeeded Boolean                  @map("custom_packaging_needed")
  privacyConsentAt      DateTime                 @map("privacy_consent_at")
  sourcePage            String                   @map("source_page")
  interfaceLanguage     InquiryInterfaceLanguage @map("interface_language")
  submittedAt           DateTime                 @map("submitted_at")
  spamReasons           String[]                 @map("spam_reasons")
  submission            InquirySubmission        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  product               Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([submittedAt])
  @@index([productId])
  @@map("quarantined_inquiry")
}

model NotificationOutboxRecord {
  id                     String   @id @default(uuid())
  inquiryId              String   @map("inquiry_id")
  inquiryReferenceNumber String   @map("inquiry_reference_number")
  recipientRole          AppRole  @map("recipient_role")
  recipientUserId        String?  @map("recipient_user_id")
  template               String
  contentPreview         String   @map("content_preview")
  createdAt              DateTime @map("created_at")
  inquiry                Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  recipientUser          User?    @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@index([inquiryId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([createdAt])
  @@map("notification_outbox_record")
}
