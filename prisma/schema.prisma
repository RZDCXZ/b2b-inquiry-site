generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  administrator
  content_editor
  sales
}

enum SpecificationDataType {
  boolean
  decimal
  enumeration
  text
}

enum SpecificationUnit {
  cubic_metre_per_minute
  kilopascal
  litre_per_minute
  micrometre
  millimetre
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(true) @map("email_verified")
  image         String?
  role          AppRole
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  auditLogs     AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

model AuditLog {
  id          String   @id @default(uuid())
  event       String
  outcome     String
  actorUserId String?  @map("actor_user_id")
  actorRole   AppRole? @map("actor_role")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_log")
}

model EnvironmentIdentity {
  key               String   @id @default("primary")
  databaseId        String   @unique @map("database_id")
  environmentMarker String   @map("environment_marker")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("environment_identity")
}

model SiteConfiguration {
  key             String   @id @default("primary")
  companyNameEn   String   @map("company_name_en")
  companyNameZhCn String   @map("company_name_zh_cn")
  contactEmail    String   @map("contact_email")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_configuration")
}

model ProductCategory {
  id                      String                             @id
  code                    String                             @unique
  position                Int                                @unique
  nameEn                  String                             @map("name_en")
  nameZhCn                String                             @map("name_zh_cn")
  products                Product[]
  specificationAttributes SpecificationAttributeDefinition[]

  @@map("product_category")
}

model Product {
  id                   String                      @id
  partNumber           String                      @map("part_number")
  normalizedPartNumber String                      @unique @default(dbgenerated()) @map("normalized_part_number")
  categoryId           String                      @map("category_id")
  imagePath            String                      @map("image_path")
  currentPublicationId String?                     @unique @map("current_publication_id")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  category             ProductCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentPublication   ProductPublication?         @relation("CurrentProductPublication", fields: [id, currentPublicationId], references: [productId, id], onDelete: NoAction)
  publications         ProductPublication[]        @relation("ProductPublicationVersions")
  specificationValues  ProductSpecificationValue[]

  @@unique([id, currentPublicationId])
  @@index([categoryId])
  @@map("product")
}

model SpecificationAttributeDefinition {
  id         String                         @id
  categoryId String                         @map("category_id")
  code       String
  position   Int
  nameEn     String                         @map("name_en")
  nameZhCn   String                         @map("name_zh_cn")
  dataType   SpecificationDataType          @map("data_type")
  baseUnit   SpecificationUnit?             @map("base_unit")
  required   Boolean
  filterable Boolean
  category   ProductCategory                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options    SpecificationAttributeOption[]
  values     ProductSpecificationValue[]

  @@unique([categoryId, code])
  @@unique([id, dataType])
  @@unique([id, baseUnit])
  @@unique([categoryId, position])
  @@map("specification_attribute_definition")
}

model SpecificationAttributeOption {
  attributeId String                           @map("attribute_id")
  code        String
  position    Int
  labelEn     String                           @map("label_en")
  labelZhCn   String                           @map("label_zh_cn")
  attribute   SpecificationAttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([attributeId, code])
  @@unique([attributeId, position])
  @@map("specification_attribute_option")
}

model ProductSpecificationValue {
  productId        String                           @map("product_id")
  attributeId      String                           @map("attribute_id")
  decimalValue     Decimal?                         @map("decimal_value") @db.Decimal(18, 6)
  booleanValue     Boolean?                         @map("boolean_value")
  enumerationValue String?                          @map("enumeration_value")
  textValue        String?                          @map("text_value")
  product          Product                          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute        SpecificationAttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([productId, attributeId])
  @@index([attributeId])
  @@map("product_specification_value")
}

model ProductPublication {
  id          String   @id
  productId   String   @map("product_id")
  version     Int
  nameEn      String   @map("name_en")
  slugEn      String   @map("slug_en")
  summaryEn   String   @map("summary_en")
  nameZhCn    String   @map("name_zh_cn")
  slugZhCn    String   @map("slug_zh_cn")
  summaryZhCn String   @map("summary_zh_cn")
  publishedAt DateTime @default(now()) @map("published_at")
  product     Product  @relation("ProductPublicationVersions", fields: [productId], references: [id], onDelete: Cascade)
  currentFor  Product? @relation("CurrentProductPublication")

  @@unique([productId, version])
  @@unique([productId, id])
  @@map("product_publication")
}
